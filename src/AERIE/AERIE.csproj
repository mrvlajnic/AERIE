<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain C# WPF, no XAML: the window is built in code, which keeps the app
       small and lets it build from any OS (EnableWindowsTargeting). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AERIE</RootNamespace>
    <AssemblyName>AERIE</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>search.ico</ApplicationIcon>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <Product>AERIE</Product>
    <Company>AERIE for Windows contributors</Company>
    <Description>A small, fast, quiet web browser for Windows.</Description>
    <Copyright>MIT · original Search for Mac © Office Commun</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Implicit usings pull in System.Windows.Forms names otherwise. -->
    <UseWindowsForms>false</UseWindowsForms>
    <!-- The app's own process kept small: one GC heap, no background GC
         thread, memory returned to Windows rather than held for reuse. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Readable exception messages in Debug; trimmed keys only in Release. -->
    <UseSystemResourceKeys Condition="'$(Configuration)' != 'Debug'">true</UseSystemResourceKeys>
    <!-- One file to hand out: the WebView2 loader rides inside the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\AERIE.Core\AERIE.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>
</Project>
